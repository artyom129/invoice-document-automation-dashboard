# Copy to .env or pass these through your shell or container.

DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads

# Largest PDF accepted, in megabytes.
MAX_UPLOAD_MB=10

# Invoices at or above this confidence are approved automatically.
AUTO_APPROVE_THRESHOLD=80

# Rows per page on the dashboard.
PAGE_SIZE=50

# run.py only: address, port and auto-reload for the development server.
HOST=127.0.0.1
PORT=8000
RELOAD=1
